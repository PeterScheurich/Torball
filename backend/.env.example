COUCHDB_URL=http://192.168.188.96:5984
COUCHDB_DB=torball
COUCHDB_USER=torball_backend
COUCHDB_PASSWORD=

# Optional: E-Mail-Versand (Einladungen, Passwort-Reset). Ohne diese Variablen
# faellt das Backend auf die alte Loesung zurueck (Link in der API-Antwort
# bzw. im Server-Log statt per Mail).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Torball-Turniere" <noreply@example.com>

# Basis-URL des Frontends, fuer Links in E-Mails (Einladung, Passwort-Reset).
FRONTEND_URL=http://localhost:5173

# Session-Cookie mit Secure-Flag ausliefern (nur ueber HTTPS gueltig). In
# Produktion hinter HTTPS zwingend "true" setzen; lokal (HTTP) weglassen bzw.
# "false", sonst setzt der Browser das Cookie nicht und der Login schlaegt fehl.
COOKIE_SECURE=false

# Entwicklungs-Kanban-Board (nur Admins): Schaltet den schreibenden JSON-Import
# (Zusammenfuehren fremder Exporte) frei. Bewusst nur auf der Entwicklungs-Instanz
# auf "true" setzen - dort werden die Staende zentral zusammengefuehrt. Auf Prod
# weglassen/"false": dort ist nur der Export moeglich. Siehe docs/kanban-board.md.
KANBAN_SYNC=false
