# Port/Host des Backends. Default 3000/0.0.0.0. In Produktion bekommt jede Instanz
# ihren eigenen PORT (mehrere Instanzen auf einem Host, z. B. prod=3001, demo=3002);
# lokal weglassen (dann 3000, passend zum Vite-Dev-Proxy).
PORT=3000
# HOST=127.0.0.1

# Adresse der eigenen CouchDB. Bei lokaler CouchDB (Prod-Server/Windows) 127.0.0.1;
# fuer eine im Netz erreichbare Instanz die entsprechende Adresse eintragen.
COUCHDB_URL=http://127.0.0.1:5984
COUCHDB_DB=torball
COUCHDB_USER=torball_backend
COUCHDB_PASSWORD=

# E-Mail-Versand (Einladungen, Passwort-Reset) wird NICHT hier eingetragen, sondern ueber die
# Oberflaeche gepflegt (Admin-Menue -> Systemeinstellungen -> "E-Mail-Versand (SMTP)"), damit er
# ohne Server-Zugriff/Neustart aenderbar ist - analog zum Mail-Postfach. Ohne aktivierten/
# vollstaendig eingerichteten Versand faellt das Backend auf die alte Loesung zurueck (Link in der
# API-Antwort bzw. im Server-Log statt per Mail).

# Basis-URL des Frontends, fuer Links in E-Mails (Einladung, Passwort-Reset).
FRONTEND_URL=http://localhost:5173

# Session-Cookie mit Secure-Flag ausliefern (nur ueber HTTPS gueltig). In
# Produktion hinter HTTPS zwingend "true" setzen; lokal (HTTP) weglassen bzw.
# "false", sonst setzt der Browser das Cookie nicht und der Login schlaegt fehl.
COOKIE_SECURE=false

# Proxy-Vertrauen fuer das Rate-Limiting (damit es die ECHTE Client-IP kennt, statt der IP des
# davorliegenden Reverse-Proxys). Nicht gesetzt (Default): Loopback + private Netzbereiche werden
# vertraut - passt fuer beide Betriebsarten (externer Nginx Proxy Manager -> Instanz-nginx ->
# Backend, sowie reiner LAN-Zugriff) und ist von aussen nicht faelschbar. Andere Werte: "false"
# (keinem Proxy vertrauen), "true" (allen - nur in kontrollierter Umgebung), eine Zahl (Anzahl
# Proxy-Hops) oder eine Kommaliste konkreter IPs/CIDR-Bereiche. Siehe backend/src/rateLimit.ts.
# TRUST_PROXY=

# Entwicklungs-Kanban-Board (nur Admins): Schaltet das gesamte Board frei (Menuepunkt +
# Routen). Bewusst nur auf der Entwicklungs-Instanz auf "true" setzen - Feedback/Fehlermeldungen
# von Prod/Demo laufen ueber das Mail-Postfach (siehe MAIL_POSTFACH_AKTIV unten), das erkannte
# Anforderungen automatisch als Kanban-Karte anlegt; ein eigenes Board auf Prod/Demo braucht es
# dafuer nicht. Siehe docs/kanban-board.md.
KANBAN_BOARD_AKTIV=false

# Einzelprozess-Modus: das Backend liefert das gebaute Frontend (frontend/dist) gleich mit aus,
# kein separater nginx/Vite-Proxy noetig - gedacht fuer die lokale Windows-Installation
# (deploy/installieren-windows.ps1). Auf dem Debian-Produktivserver (deploy/deploy-instanz.sh)
# weglassen/"false": dort uebernimmt nginx das Ausliefern des Frontends + Proxy zu /api.
SERVE_FRONTEND=false

# Mail-Postfach (nur Admins, siehe backend/src/mail/): liest per IMAP ein zentrales
# Feedback-Postfach der Software (Fehlermeldungen/Lob/Anregungen/Kritik/Spam), fasst neue Mails
# per KI (Anthropic) zusammen und legt erkannte Anforderungen automatisch, aber klar als
# "KI-erstellt/ungeprueft" markiert, im Entwicklungs-Kanban-Board an. Bewusst nur auf der
# Entwicklungsinstanz auf "true" setzen - gleiches Muster wie KANBAN_BOARD_AKTIV. IMAP-Zugang, der
# Anthropic-API-Key und die Bericht-Zieladresse werden NICHT hier eingetragen, sondern ueber die
# Oberflaeche gepflegt (Admin-Menue -> Mail-Postfach -> Einstellungen), damit sie ohne
# Server-Zugriff/Neustart aenderbar sind.
MAIL_POSTFACH_AKTIV=false
