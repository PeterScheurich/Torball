{
  "name": "@torball/backend",
  "version": "0.9.0-beta",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node --env-file=.env dist/index.js",
    "test": "tsx --test src/**/*.test.ts",
    "test:integration": "tsx --env-file=.env.test.local --test src/**/*.test.ts",
    "torball": "tsx --env-file=.env src/cli/torball.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@torball/shared": "*",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.2.0",
    "imapflow": "^1.7.0",
    "mailparser": "^3.9.15",
    "nano": "^11.0.6",
    "nodemailer": "^9.0.5",
    "otplib": "^13.4.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
